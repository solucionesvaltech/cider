{
  "name": "cider",
  "description": "Design game cards using HTML/Handlebars, CSS, and tabular data.",
  "author": {
    "name": "Hristo Iankov"
  },
  "version": "0.4.8",
  "repository": "https://github.com/oatear/cider",
  "main": "electron-app/dist/main.js",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "build:gh-pages": "ng build --base-href=/cider/",
    "watch": "ng build --watch --configuration development",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "e2e": "playwright test",
    "e2e:ui": "playwright test --ui",
    "electron": "ng build --base-href ./ && tsc --p electron-app && electron .",
    "electron:compile": "ng build --base-href ./ && tsc --p electron-app",
    "electron:build": "ng build --base-href ./ && tsc --p electron-app && electron-builder build --publish=never"
  },
  "browser": {
    "fs": false,
    "path": false,
    "os": false
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "^16.1.3",
    "@angular/cdk": "^16.1.3",
    "@angular/common": "^16.1.3",
    "@angular/compiler": "^16.1.3",
    "@angular/core": "^16.1.3",
    "@angular/forms": "^16.1.3",
    "@angular/platform-browser": "^16.1.3",
    "@angular/platform-browser-dynamic": "^16.1.3",
    "@angular/router": "^16.1.3",
    "@materia-ui/ngx-monaco-editor": "^6.0.0",
    "@swimlane/ngx-charts": "^20.5.0",
    "@types/dom-to-image": "^2.6.4",
    "@types/uuid": "^9.0.2",
    "dexie": "^3.2.4",
    "dexie-export-import": "^4.0.7",
    "file-saver": "^2.0.5",
    "handlebars": "^4.7.7",
    "html-to-image": "^1.11.11",
    "jszip": "^3.10.0",
    "mime": "^3.0.0",
    "mime-wrapper": "^2.0.0",
    "monaco-editor": "^0.39.0",
    "p-limit": "^4.0.0",
    "pdfmake": "^0.2.7",
    "primeflex": "^2.0.0",
    "primeicons": "^6.0.1",
    "primeng": "^16.0.2",
    "rxjs": "^7.8.1",
    "swiper": "^11.2.10",
    "tslib": "^2.6.0",
    "uuid": "^9.0.0",
    "xlsx": "^0.18.5",
    "zone.js": "^0.13.1"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "^16.1.3",
    "@angular/cli": "^16.1.3",
    "@angular/compiler-cli": "^16.1.3",
    "@playwright/test": "^1.60.0",
    "@types/d3-array": "^3.2.2",
    "@types/d3-brush": "^3.0.6",
    "@types/d3-color": "^3.1.3",
    "@types/d3-drag": "^3.0.7",
    "@types/d3-ease": "^3.0.2",
    "@types/d3-force": "^3.0.10",
    "@types/d3-format": "^3.0.4",
    "@types/d3-hierarchy": "^3.1.7",
    "@types/d3-interpolate": "^3.0.4",
    "@types/d3-path": "^3.1.1",
    "@types/d3-scale": "^4.0.9",
    "@types/d3-selection": "^3.0.11",
    "@types/d3-shape": "^3.1.8",
    "@types/d3-time": "^3.0.4",
    "@types/d3-time-format": "^4.0.3",
    "@types/d3-transition": "^3.0.9",
    "@types/electron": "^1.6.10",
    "@types/file-saver": "^2.0.5",
    "@types/jest": "^29.5.14",
    "@types/node": "^18.16.19",
    "@types/pdfmake": "^0.2.2",
    "electron": "^25.2.0",
    "electron-builder": "^24.5.2",
    "fake-indexeddb": "^5.0.2",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "jest-preset-angular": "^13.1.6",
    "typescript": "~4.9.5"
  }
}
